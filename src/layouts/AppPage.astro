---
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import { App } from "../components/App";
import { appPath } from "../lib/app-routes";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#090b09" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="Night Ledger" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Night Ledger" />
    <meta name="description" content="Private household receipt and bank spending tracker." />
    <link rel="manifest" href={appPath("/manifest.webmanifest")} />
    <link rel="icon" sizes="192x192" href={appPath("/icons/icon-192.png?v=2")} />
    <link rel="apple-touch-icon" sizes="180x180" href={appPath("/icons/apple-touch-icon.png?v=2")} />
    <title>Night Ledger · Household finance</title>
  </head>
  <body>
    <App client:load />
  </body>
</html>
